@model REPO_GENERICMETHOD.Models.Bignners

@{
    ViewData["Title"] = "ADD_Bignners";
}

<h1>ADD_Bignners</h1>

<h4>Bignners</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ADD_Bignners">
