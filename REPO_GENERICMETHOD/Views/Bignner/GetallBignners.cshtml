@model IEnumerable<REPO_GENERICMETHOD.Models.Bignners>

@{
    ViewData["Title"] = "Beginners List";
}

<h2 class="mt-4 mb-3 text-primary fw-bold">Beginners List</h2>

<div class="mb-3">
    <a asp-action="ADD_Bignners" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</div>

<table class="table table-bordered table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.B_Name)</th>
            <th>@Html.DisplayNameFor(model => model.B_Age)</th>
            <th>@Html.DisplayNameFor(model => model.B_Level)</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.B_Name)</td>
                <td>@Html.DisplayFor(modelItem => item.B_Age)</td>
                <td>@Html.DisplayFor(modelItem => item.B_Level)</td>

                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning me-1">
                        Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info me-1 text-white">
                        Details
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
