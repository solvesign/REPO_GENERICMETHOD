@model IEnumerable<REPO_GENERICMETHOD.Models.Player>

@{
    ViewData["Title"] = "All Players";
}

<h2 class="mt-4 mb-3 text-primary fw-bold">PLAYER_RECORDS</h2>

<div class="mb-3">
    <a asp-action="ADD_PLayer" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> NEW_PLAYER
    </a>
</div>

<table class="table table-bordered table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Player_Name)</th>
            <th>@Html.DisplayNameFor(model => model.Player_Age)</th>
            <th>@Html.DisplayNameFor(model => model.Player_Lavel)</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Player_Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Player_Age)</td>
                <td>@Html.DisplayFor(modelItem => item.Player_Lavel)</td>

                <td class="text-center">
                    <a asp-action="Edit_Player" asp-route-id="@item.PlayerID" class="btn btn-sm btn-warning me-1">
                        EDIT
                    </a>
                    <a asp-action="DetailsofPlayer" asp-route-id="@item.PlayerID" class="btn btn-sm btn-info me-1 text-white">
                        DETAILS
                    </a>
                    <a asp-action="DeletePlayer" asp-route-id="@item.PlayerID" class="btn btn-sm btn-danger">
                        DEL
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>
